# Local development settings. This file is currently tracked by Git:
# do not commit real credentials. Export them in your shell instead.
ENV=local

# HTTP server.
HTTP_ADDRESS=127.0.0.1:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=5s
STARTUP_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL: create post_service first, then run go run ./cmd/migrate up.
# local-password is an example; use the credentials of your local PostgreSQL.
DATABASE_URL=postgres://postgres:local-password@127.0.0.1:5432/post_service?sslmode=disable

# Redis must be running. AOF and noeviction are configured on the Redis server,
# not here; see docs/reactions.md for reaction durability requirements.
REDIS_URL=redis://127.0.0.1:6379/0

# Public RSA signing keys served by your authentication service.
# Replace this example URL if the auth service uses a different address.
# The endpoint must be available at startup; a JWT secret is not needed here.
JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json

# Docker Compose settings (local development only).
# Compose overrides DATABASE_URL, REDIS_URL and HTTP_ADDRESS for its network.
# Use a URL-safe PostgreSQL password here (letters, digits, hyphen, underscore).
# Keep DATABASE_URL above in sync if you also run Go directly on the host.
POSTGRES_PASSWORD=local-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
# Auth runs on the host; replace with a reachable auth endpoint if needed.
DOCKER_JWKS_URL=http://host.docker.internal:8081/.well-known/jwks.json
# Must exceed HTTP_SHUTDOWN_TIMEOUT plus time for the worker to stop.
DOCKER_STOP_GRACE_PERIOD=30s
